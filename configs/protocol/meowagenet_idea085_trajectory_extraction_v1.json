    "difference_from_IDEA068_summaries": "IDEA-068 computed RMS, tilt, and flatness summaries on finite-F0 voiced frames. IDEA-085 retains these three channels on every computable frame; the old voiced-only summaries remain reconstructable using finite log_f0 as the mask.",
    "time_seconds_stored_for_audit_only": true,
    "time_seconds_model_input": false
  },
  "cache_schema": {
    "call_ids": {"shape": "[N]", "dtype": "Unicode"},
