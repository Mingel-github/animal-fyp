# Keep hash-addressed text artifacts byte-stable across Windows and Unix clones.
.gitattributes text eol=lf
.gitmodules text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.mjs text eol=lf
*.sha256 text eol=lf

# Preserve the exact bytes of the completed formal-run audit records so the
# published files retain the SHA-256 values recorded at execution time.
runs/meowagenet_formal_v2_1_core/**/*.json -text whitespace=cr-at-eol

# Generated manifests were hashed with their original byte representation.
*.csv -text

# Explicit binary formats.
*.npz -text
*.npy -text
*.wav -text
*.pt -text
*.pth -text
